# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you always want to normalize so they always have LF in repo
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.java text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows batch scripts must use CRLF
*.bat text eol=crlf
